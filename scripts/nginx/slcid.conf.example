# Sustituir slcid.example.edu y las rutas de certificados. Incluir en http{}.
# El backend escucha loopback; no publique el puerto 8000 ni PostgreSQL.
map $request_method $slcid_write_key {
    default $binary_remote_addr;
    GET "";
    HEAD "";
    OPTIONS "";
}
limit_req_zone $binary_remote_addr zone=slcid_read:10m rate=300r/m;
limit_req_zone $slcid_write_key zone=slcid_write:10m rate=120r/m;
limit_req_zone $binary_remote_addr zone=slcid_auth:10m rate=10r/m;

server {
    listen 80;
    server_name slcid.example.edu;
    return 301 https://slcid.example.edu$request_uri;
}
server {
    listen 443 ssl;
    server_name slcid.example.edu;
    ssl_certificate /etc/ssl/slcid/fullchain.pem;
    ssl_certificate_key /etc/ssl/slcid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 64m;
    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 30s;
    limit_req_status 429;
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    # Las sondas se consultan directamente dentro del contenedor, nunca por TLS público.
    location = /salud { return 404; }
    location ^~ /salud/ { return 404; }

    location ~ ^/(?:es/|en/)?(accounts/|login/|register/|admin/login/) {
        limit_req zone=slcid_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    location / {
        limit_req zone=slcid_read burst=60 nodelay;
        limit_req zone=slcid_write burst=30 nodelay;
        proxy_pass http://127.0.0.1:8000;
    }
    # No añadir alias /media/: la aplicación autoriza cada archivo privado.
}
