DJANGO_DEBUG=False
# Mantener False. Solo una instalacion local desechable debe habilitar cargas
# ficticias, y cada comando exige ademas unidad y confirmacion explicitas.
SLCID_ALLOW_DEMO_DATA_COMMANDS=False
SECRET_KEY=replace-with-a-secure-secret-key
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://laboratorios.upec.edu.ec
# Vacío: portal y backend del mismo origen; no se habilita ninguna app externa.
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WRITE_PER_MINUTE=120
SLCID_RLS_ENABLED=false

# Cada aplicación independiente consume recursos. Por defecto se pone en marcha
# con el botón del administrador; subir un ZIP no crea un contenedor.
MICROPROYECTOS_DESPLIEGUE_AUTOMATICO=false

DB_NAME=replace-with-database-name
# Destino independiente Centros: vacío conserva instalación de una base.
# Preparar CENTROS_DB_NAME con flag false; activar SOLO tras copia verificada.
# Dos bases por dominio, no por unidad. Servidor compartido o dedicado:
# docs/estructura-bases-datos-docker.md. Compose compartido dirige Centros a db.
CENTROS_DB_ENABLED=false
CENTROS_DB_NAME=
CENTROS_DB_HOST=
CENTROS_DB_PORT=5432
CENTROS_DB_USER=citt_centros_web
CENTROS_DB_PASSWORD=
CENTROS_DB_MIGRATION_USER=citt_centros_owner
CENTROS_DB_MIGRATION_PASSWORD=
CENTROS_DB_BACKUP_USER=citt_centros_backup
CENTROS_DB_BACKUP_PASSWORD=
CENTROS_DB_NETWORK_ISOLATED=false
CENTROS_DB_SSLMODE=
CENTROS_DB_SSLROOTCERT=
CENTROS_DB_CONN_MAX_AGE=60
CENTROS_DB_CONNECT_TIMEOUT=3
CENTROS_DB_STATEMENT_TIMEOUT_MS=30000
CENTROS_DB_LOCK_TIMEOUT_MS=5000
DB_USER=replace-with-restricted-runtime-user
# Rol propietario separado, usado exclusivamente por migrar_produccion.sh.
DB_MIGRATION_USER=replace-with-migration-user
DB_MIGRATION_PASSWORD=replace-with-migration-password
DB_PASSWORD=replace-with-database-password
DB_BACKUP_USER=replace-with-backup-user
DB_BACKUP_PASSWORD=replace-with-backup-password
# IP del proxy vista por Waitress (loopback nativo; gateway de Docker si Nginx está en el host).
TRUSTED_PROXY_IP=
WEB_LISTEN=127.0.0.1:8000
# Hilos por proceso (1..64); no equivale a usuarios simultáneos soportados.
WEB_THREADS=8
WEB_CONNECTION_LIMIT=100
WEB_CHANNEL_TIMEOUT=60
DB_HOST=localhost
DB_PORT=5432
DB_NETWORK_ISOLATED=true
# Para una base externa use verify-full y configure el certificado CA.
DB_SSLMODE=
DB_SSLROOTCERT=
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000

# El destino debe estar fuera del volumen de PostgreSQL y copiarse cifrado a
# almacenamiento externo. La restauracion se comprueba periodicamente.
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400

SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
X_FRAME_OPTIONS=DENY
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Correo transaccional de reservas. No publiques la contraseña SMTP.
SITE_URL=https://laboratorios.upec.edu.ec
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=sistema.labs@upec.edu.ec
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=sistema.labs@upec.edu.ec
REQUIRE_TRANSACTIONAL_EMAIL=True
RESERVATION_EMAIL_MAX_ATTEMPTS=5
RESERVATION_EMAIL_RETRY_MINUTES=15
RESERVATION_REMINDER_INTERVAL_MINUTES=15
RESERVATION_OPERATIONAL_ALERT_DAYS=30
# Identidad publica SLCID. Cambiar a custom para otra institucion y completar
# INSTITUTION_NAME e INSTITUTION_CODE; no hereda contactos/logos de UPEC.
INSTITUTION_PROFILE=upec
# Idioma y zona por instalacion. Predeterminados compatibles incluso en custom.
# Cambiar zona exige conciliar reservas civiles existentes; no convierte datos.
INSTITUTION_LANGUAGE_CODE=es-ec
INSTITUTION_TIME_ZONE=America/Guayaquil
# Catalogo academico propio (JSON de listas; no rutas ni codigo). En custom no
# se heredan carreras UPEC. Auditar antes de sustituir codigos usados en datos.
# ACADEMIC_CATALOG_JSON={"facultades":[["ingenieria","Facultad de Ingenieria"]],"carreras":[["sistemas","Ingenieria de Sistemas","ingenieria"]],"tipos_con_carrera":["estudiante","docente"]}
SYSTEM_NAME=Sistema de Laboratorios y Centros de Investigacion y Desarrollo
SYSTEM_SHORT_NAME=Sistema de Laboratorios y Centros I+D
SYSTEM_CODE=SLCID
# INSTITUTION_NAME=Nombre de la institucion
# INSTITUTION_CODE=SIGLAS
# INSTITUTION_PHONE=
# INSTITUTION_EMAIL=
# INSTITUTION_LOCATION=
# INSTITUTION_LOGO=img/institucion/logo.png
# INSTITUTION_SECONDARY_LOGO=img/institucion/logo-secundario.png
# Etiqueta de la versión desplegada; web, migraciones y tareas comparten imagen.
SLCID_VERSION=local
